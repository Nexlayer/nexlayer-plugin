{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://nexlayer.io/schemas/nexlayer.yaml.schema.json",
  "title": "Nexlayer Deployment Configuration",
  "description": "Schema for Nexlayer YAML deployment configuration",
  "type": "object",
  "required": ["application"],
  "properties": {
    "application": {
      "type": "object",
      "required": ["name", "pods"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9.-]{2,63}$",
          "description": "Application name (lowercase, hyphens, dots, 3-64 chars, starts with letter)",
          "examples": ["my-app", "my-app-v2", "myapp"]
        },
        "domain": {
          "type": "string",
          "description": "Custom domain for the application (must be verified in Nexlayer)",
          "examples": ["app.example.com", "myapp.com"]
        },
        "imagePullSecrets": {
          "type": "array",
          "description": "Credentials for private container registries",
          "items": {
            "type": "object",
            "required": ["name", "registry", "username", "password"],
            "properties": {
              "name": {
                "type": "string",
                "description": "Secret name identifier"
              },
              "registry": {
                "type": "string",
                "description": "Registry URL (e.g., ghcr.io, docker.io)"
              },
              "username": {
                "type": "string",
                "description": "Registry username"
              },
              "password": {
                "type": "string",
                "description": "Registry password or token"
              }
            }
          }
        },
        "pods": {
          "type": "array",
          "minItems": 1,
          "description": "List of pod configurations",
          "items": {
            "$ref": "#/definitions/pod"
          }
        }
      }
    }
  },
  "definitions": {
    "pod": {
      "type": "object",
      "required": ["name", "image", "servicePorts"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$",
          "description": "Pod name (lowercase, hyphens, 2-64 chars). Becomes DNS: {name}.pod",
          "examples": ["frontend", "api", "postgres", "redis"]
        },
        "image": {
          "type": "string",
          "pattern": ".+:.+",
          "description": "Container image with tag (registry/image:tag)",
          "examples": [
            "registry.nexlayer.io/my-app/web:latest",
            "postgres:16-alpine",
            "nginx:latest"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/.*",
          "description": "URL path for external routing. Omit for internal-only services.",
          "examples": ["/", "/api", "/admin"]
        },
        "servicePorts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "description": "Ports the container listens on",
          "examples": [[3000], [8080], [5432], [6333, 6334]]
        },
        "vars": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment variables (non-sensitive). Use <% URL %> for public URL, {pod}.pod:{port} for internal.",
          "examples": [
            {
              "NODE_ENV": "production",
              "NEXT_PUBLIC_API_URL": "<% URL %>/api",
              "DATABASE_URL": "postgresql://user:pass@postgres.pod:5432/db"
            }
          ]
        },
        "secrets": {
          "type": "array",
          "description": "Sensitive data mounted as files",
          "items": {
            "$ref": "#/definitions/secret"
          }
        },
        "volumes": {
          "type": "array",
          "description": "Persistent storage volumes",
          "items": {
            "$ref": "#/definitions/volume"
          }
        },
        "resources": {
          "$ref": "#/definitions/resources"
        },
        "healthCheck": {
          "$ref": "#/definitions/healthCheck"
        }
      }
    },
    "secret": {
      "type": "object",
      "required": ["name", "mountPath", "data"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Secret group name"
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/.*",
          "description": "Path where secrets are mounted as files",
          "examples": ["/run/secrets", "/run/secrets/api"]
        },
        "data": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Key-value pairs (key becomes filename, value becomes content)"
        }
      }
    },
    "volume": {
      "type": "object",
      "required": ["name", "size", "mountPath"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Volume name"
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(Mi|Gi)$",
          "description": "Storage size (Mi for mebibytes, Gi for gibibytes)",
          "examples": ["1Gi", "10Gi", "500Mi"]
        },
        "mountPath": {
          "type": "string",
          "pattern": "^/.*",
          "description": "Path where volume is mounted. PostgreSQL: use /var/lib/postgresql NOT /var/lib/postgresql/data",
          "examples": ["/var/lib/postgresql", "/data/db", "/app/uploads"]
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "object",
          "properties": {
            "memory": {
              "type": "string",
              "pattern": "^[0-9]+(Mi|Gi)$",
              "description": "Memory request",
              "examples": ["256Mi", "1Gi"]
            },
            "cpu": {
              "type": "string",
              "pattern": "^[0-9]+m?$",
              "description": "CPU request (millicores or cores)",
              "examples": ["100m", "500m", "1"]
            }
          }
        },
        "limits": {
          "type": "object",
          "properties": {
            "memory": {
              "type": "string",
              "pattern": "^[0-9]+(Mi|Gi)$",
              "description": "Memory limit",
              "examples": ["512Mi", "2Gi"]
            },
            "cpu": {
              "type": "string",
              "pattern": "^[0-9]+m?$",
              "description": "CPU limit (millicores or cores)",
              "examples": ["500m", "1", "2"]
            }
          }
        }
      }
    },
    "healthCheck": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "HTTP path for health check (omit for TCP check)",
          "examples": ["/health", "/healthz", "/"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Port for health check"
        },
        "initialDelaySeconds": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Seconds to wait before first check"
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 1,
          "default": 10,
          "description": "Seconds between checks"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "default": 5,
          "description": "Seconds to wait for response"
        },
        "failureThreshold": {
          "type": "integer",
          "minimum": 1,
          "default": 3,
          "description": "Failures before marking unhealthy"
        }
      }
    }
  }
}
